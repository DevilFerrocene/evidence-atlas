{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evidence-atlas.local/schemas/paper.schema.json",
  "title": "Evidence Atlas paper bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "paper", "paragraphs", "claims", "evidence", "sources"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "paper": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "authors", "year", "citation", "source_url", "rights", "edition", "scope", "audited_at"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/bi" },
        "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "year": { "type": "integer" },
        "citation": { "type": "string", "minLength": 1 },
        "doi": { "type": "string" },
        "source_url": { "$ref": "#/definitions/url" },
        "original_url": { "$ref": "#/definitions/url" },
        "rights": { "$ref": "#/definitions/bi" },
        "edition": { "$ref": "#/definitions/bi" },
        "scope": { "$ref": "#/definitions/bi" },
        "audited_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "sections": { "type": "array", "items": { "type": "object", "required": ["id", "label", "paragraph_id"], "properties": { "id": { "$ref": "#/definitions/id" }, "label": { "$ref": "#/definitions/bi" }, "paragraph_id": { "$ref": "#/definitions/id" } }, "additionalProperties": false } }
      }
    },
    "paragraphs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "type", "segments"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "type": { "enum": ["body", "equation", "footnote", "caption", "table", "heading"] },
          "locator": { "type": "string" },
          "segments": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "en", "zh", "kind", "claim_ids"],
              "properties": {
                "id": { "$ref": "#/definitions/id" },
                "en": { "type": "string", "minLength": 1 },
                "zh": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["claim", "equation", "context"] },
                "latex": { "type": "string" },
                "claim_ids": { "$ref": "#/definitions/ids" },
                "exclusion_reason": { "$ref": "#/definitions/bi" }
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "kind", "assessment", "summary", "limits", "segment_ids", "evidence_ids"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "title": { "$ref": "#/definitions/bi" },
          "kind": { "type": "string", "minLength": 1 },
          "assessment": { "enum": ["supported", "conditional", "open", "proposal", "mixed", "unsupported", "miscited", "outdated"] },
          "summary": { "$ref": "#/definitions/bi" },
          "why": { "$ref": "#/definitions/bi" },
          "story": { "type": "array", "items": { "type": "object", "required": ["text", "evidence_ids"], "additionalProperties": false, "properties": { "heading": { "$ref": "#/definitions/bi" }, "text": { "$ref": "#/definitions/bi" }, "evidence_ids": { "$ref": "#/definitions/nonemptyIds" } } } },
          "reasoning": { "type": "array", "items": { "$ref": "#/definitions/bi" } },
          "limits": { "type": "array", "items": { "$ref": "#/definitions/bi" } },
          "segment_ids": { "$ref": "#/definitions/nonemptyIds" },
          "evidence_ids": { "$ref": "#/definitions/nonemptyIds" },
          "quantities": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "value", "calculation", "interpretation"], "properties": { "label": { "$ref": "#/definitions/bi" }, "value": { "type": "string" }, "calculation": { "type": "string" }, "interpretation": { "$ref": "#/definitions/bi" } } } },
          "findings": { "type": "array", "items": { "type": "object", "required": ["label", "detail", "evidence_ids"], "additionalProperties": false, "properties": { "label": { "$ref": "#/definitions/bi" }, "detail": { "$ref": "#/definitions/bi" }, "evidence_ids": { "$ref": "#/definitions/ids" } } } }
        }
      }
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source_id", "locator", "role", "relation", "finding", "method", "depends_on"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "source_id": { "anyOf": [{ "$ref": "#/definitions/id" }, { "type": "null" }] },
          "locator": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 },
          "finding": { "$ref": "#/definitions/bi" },
          "method": { "$ref": "#/definitions/bi" },
          "depends_on": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["evidence_id", "relation"], "properties": { "evidence_id": { "$ref": "#/definitions/id" }, "relation": { "type": "string", "minLength": 1 }, "label": { "$ref": "#/definitions/bi" } } } },
          "terminal": { "type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": { "kind": { "type": "string", "minLength": 1 }, "reason": { "$ref": "#/definitions/bi" } } }
        }
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "authors", "year", "url", "type", "access", "retrieved_at", "note"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "title": { "type": "string", "minLength": 1 },
          "authors": { "type": "string", "minLength": 1 },
          "year": { "type": ["integer", "null"] },
          "url": { "$ref": "#/definitions/url" },
          "doi": { "type": "string" },
          "type": { "type": "string", "minLength": 1 },
          "access": { "enum": ["full_text", "provided_full_text", "provided_excerpt", "abstract_only", "metadata_only", "unavailable"] },
          "retrieved_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "note": { "$ref": "#/definitions/bi" },
          "local_path": { "type": "string", "pattern": "^sources/[a-zA-Z0-9_.-]+$" }
        }
      }
    }
  },
  "definitions": {
    "bi": { "type": "object", "required": ["en", "zh"], "additionalProperties": false, "properties": { "en": { "type": "string", "minLength": 1 }, "zh": { "type": "string", "minLength": 1 } } },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$", "maxLength": 100 },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "nonemptyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "url": { "type": "string", "pattern": "^https?://[^\\s]+$" }
  }
}
